# Copy to `.env` for local E2E runs. Never commit the real funded-account mnemonic.
E2E_KAVA_FUNDED_ACCOUNT_MNEMONIC='<set-a-funded-test-mnemonic>'
E2E_RUN_KVTOOL_NETWORKS=true
E2E_KVTOOL_KAVA_CONFIG_TEMPLATE="v0.27"
E2E_INCLUDE_IBC_TESTS=false
E2E_SKIP_SHUTDOWN=false
E2E_INCLUDE_AUTOMATED_UPGRADE=true
E2E_KAVA_UPGRADE_NAME=v0.28.0
E2E_KAVA_UPGRADE_HEIGHT=35
E2E_KAVA_UPGRADE_BASE_IMAGE_TAG=v0.27.1-goleveldb
E2E_KAVA_ERC20_ADDRESS=0xeA7100edA2f805356291B0E55DaD448599a72C6d
